# Lingonberry environment
#
# Absolute path on the host where proxy data (proxy.db, wireguard configs)
# is stored. Must be absolute - the Docker daemon bind-mounts subdirectories
# of it into per-customer gateway containers.
HOST_DATA_DIR=/srv/lingonberry/data

# Public host/IP that RPis use as their WireGuard endpoint.
PUBLIC_ENDPOINT_HOST=vpn.example.com

# Admin API key. If unset, the admin API is open (dev mode only!).
ADMIN_KEY=change-me
